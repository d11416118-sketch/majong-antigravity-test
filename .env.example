PORT=5001
FLASK_DEBUG=0
SECRET_KEY=change_me_for_hosting
# Optional. Relative paths are anchored to the project root, not the current shell directory.
# MAHJONG_DB_PATH=data/mahjong.db

# heuristic | ollama | gemini | nvidia | openai_compatible
# heuristic uses only Python. ollama uses a local model; the other providers use external APIs.
AI_PROVIDER=heuristic

# Local Ollama. No API key is required.
OLLAMA_API_BASE=http://127.0.0.1:11434
# Docker Compose uses this host address instead of the container's own 127.0.0.1.
DOCKER_OLLAMA_API_BASE=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=10m

# Generic OpenAI-compatible endpoint, including NVIDIA.
# For NVIDIA, set AI_PROVIDER=nvidia and use its chat/completions base URL.
AI_API_KEY=your_api_key_here
AI_API_BASE=https://integrate.api.nvidia.com/v1
AI_MODEL=your_model_name_here

# Keep API usage low. The server falls back to local heuristics when busy.
AI_MAX_CONCURRENT_REQUESTS=1
AI_REQUEST_COOLDOWN_SECONDS=1.5
AI_CACHE_TTL_SECONDS=45
AI_TIMEOUT_SECONDS=8

# Legacy Gemini-compatible settings also work.
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
